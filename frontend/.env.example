# Backend FastAPI (si no está definido, el frontend opera en MODO DEMO con datos de ejemplo)
NEXT_PUBLIC_API_URL=

# Usado por vercel.json para reescribir /api/* al backend (solo en Vercel)
BACKEND_URL=

# API key que el frontend envía en X-API-Key a los endpoints de escritura
NEXT_PUBLIC_API_KEY=

# URL pública del sitio (para el QR de la etiqueta)
NEXT_PUBLIC_SITE_URL=
